# App
APP_ENV=development
APP_SECRET_KEY=change_me_in_production
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://trueshot:password@localhost:5432/trueshot
DATABASE_SYNC_URL=postgresql://trueshot:password@localhost:5432/trueshot

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage (S3-compatible)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET_UPLOADS=trueshot-uploads
S3_BUCKET_OUTPUTS=trueshot-outputs
S3_ENDPOINT_URL=http://localhost:9000
CLOUDFRONT_DOMAIN=

# Auth — Clerk
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Payments — Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI Providers (add real keys in .env.local)
OPENAI_API_KEY=sk-...
REPLICATE_API_KEY=r8_...
STABILITY_API_KEY=sk-...

# Security
INTERNAL_API_SECRET=your_internal_secret_here
ALLOWED_ORIGINS=http://localhost:3000

# Observability
SENTRY_DSN=
